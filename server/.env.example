# Server secrets only. Never copy OPENAI_API_KEY into EXPO_PUBLIC_* or the app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/gateway.sqlite
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
AI_TIMEOUT_MS=20000
MAX_OUTPUT_TOKENS=800
USER_DAILY_REQUESTS=30
GLOBAL_DAILY_REQUESTS=500
USER_REQUESTS_PER_MINUTE=6
GLOBAL_CONCURRENCY=4
# Operator-defined conservative allowance; not the provider's measured bill.
RESERVE_MICRO_USD_PER_CALL=50000
DAILY_BUDGET_MICRO_USD=2000000
